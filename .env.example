# Server
APP_NAME=Browser Agent Toolkit
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=["*"]

# Auth (API keys). REQUIRE_AUTH=true means every route except /health, /ready, /docs
# and /accounts/signup needs an "Authorization: Bearer <key>" header.
REQUIRE_AUTH=true
# Comma-separated bootstrap keys granted admin+use scope in a bootstrap organization.
API_KEYS=change-me-admin-key

# Persistence. DATABASE_URL is a full async DSN; leave it empty to derive a SQLite
# file from DB_PATH (development and tests). Production uses Postgres.
DATABASE_URL=postgresql+asyncpg://bat:bat@localhost:5432/bat
DB_PATH=data/keys.db

# Plan assigned to new self-serve signups.
DEFAULT_PLAN=free
RATE_LIMIT_PER_MIN=120
MAX_SESSIONS_PER_KEY=4
MCP_HTTP_PATH=/mcp

# Shared services (Phase 2: global rate limiting, session registry, queues)
REDIS_URL=redis://localhost:6379/0

# Billing (Stripe). Optional until billing is switched on.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Browser
BROWSER_TYPE=chromium
HEADLESS=true
DEFAULT_TIMEOUT_MS=30000
MAX_SESSIONS=8
SESSION_IDLE_SECONDS=900
ARTIFACTS_DIR=artifacts

# LLM (any OpenAI-compatible chat completions endpoint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
AGENT_MAX_STEPS=25

# Limits
MAX_TEXT_CHARS=8000
MAX_HTML_CHARS=20000

# --- Phase 2: async jobs, workers, artifacts -------------------------------
# Run a worker inside the API process (single node, no separate process needed).
# Set false when running dedicated workers with `python -m app.worker`.
RUN_INLINE_WORKER=true
# Max concurrent jobs a single tenant may occupy inside one worker (fairness).
JOBS_MAX_CONCURRENT_PER_ORG=2
# Attempts per job (1 initial + retries) and the worker poll interval in seconds.
JOB_MAX_ATTEMPTS=2
WORKER_POLL_SECONDS=1.0
# Jobs stuck in 'running' longer than this are requeued by the reaper.
JOB_LEASE_SECONDS=900
# Outbound webhook signing: HMAC-SHA256 of the body, header X-BAT-Signature.
WEBHOOK_SIGNING_SECRET=
WEBHOOK_TIMEOUT_SECONDS=10
# Session registry TTL for sessions published to Redis, seconds.
SESSION_REGISTRY_TTL_SECONDS=1800
# Artifact links: base URL used in signed links, the HMAC secret and the TTL.
ARTIFACT_BASE_URL=http://localhost:8080
ARTIFACT_SIGNING_SECRET=change-me-artifact-secret
ARTIFACT_TTL_SECONDS=3600
# Object storage (optional). When S3_BUCKET is set, artifacts use S3 presigned URLs.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
