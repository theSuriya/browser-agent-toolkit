# Server
APP_NAME=Browser Agent Toolkit
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=["*"]

# Auth (API keys). REQUIRE_AUTH=true means every route except /health and /docs
# needs an "Authorization: Bearer <key>" header.
REQUIRE_AUTH=true
# Comma-separated bootstrap keys granted the admin scope (can mint/revoke keys).
API_KEYS=change-me-admin-key
DB_PATH=data/keys.db
RATE_LIMIT_PER_MIN=120
MAX_SESSIONS_PER_KEY=4
MCP_HTTP_PATH=/mcp

# Browser
BROWSER_TYPE=chromium
HEADLESS=true
DEFAULT_TIMEOUT_MS=30000
MAX_SESSIONS=8
SESSION_IDLE_SECONDS=900
ARTIFACTS_DIR=artifacts

# LLM (any OpenAI-compatible chat completions endpoint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
AGENT_MAX_STEPS=25

# Limits
MAX_TEXT_CHARS=8000
MAX_HTML_CHARS=20000
